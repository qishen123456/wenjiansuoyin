    itemStyle: { color: colors[d.ext.toLowerCase()] || '#94A3B8' }
  }));

  const total = distribution.reduce((sum, d) => sum + d.count, 0);

  const option = {
    tooltip: {
      trigger: 'item',
      backgroundColor: '#0F172A',
      borderColor: '#334155',
      textStyle: { color: '#F8FAFC', fontSize: 12 },
      formatter: (params) => `
        <div style="padding:2px 4px">
          <div style="font-weight:700;color:#FFF">格式：${params.name}</div>
          <div style="color:#94A3B8;font-size:11px">数量：<strong style="color:#34D399;font-size:13px">${params.value.toLocaleString()}</strong> 份 (${params.percent}%)</div>
          <div style="font-size:10.5px;color:#38BDF8;margin-top:4px">⚡ 点击扇区直接按格式筛选</div>
        </div>`
    },
    legend: {
      bottom: '2%',
      left: 'center',
      itemWidth: 10,
      itemHeight: 10,
      textStyle: { fontSize: 11.5, color: '#475569', fontWeight: 600 }
    },
    series: [
      {
        type: 'pie',
        radius: ['52%', '76%'],
        center: ['50%', '44%'],
        avoidLabelOverlap: false,
        itemStyle: {
          borderRadius: 8,
          borderColor: '#FFFFFF',
          borderWidth: 3
        },
        label: {
          show: true,
          position: 'center',
          formatter: () => `{total|${(total/1000).toFixed(0)}k}\n{sub|全盘文件}`,
          rich: {
            total: { fontSize: 22, fontWeight: 800, color: '#0F172A', fontFamily: 'monospace' },
            sub: { fontSize: 11, color: '#64748B', lineHeight: 18 }
          }
        },
        emphasis: {
          label: {
            show: true,
            formatter: '{b}\n{d}%',
            fontSize: 14,
            fontWeight: 800,
            color: '#2563EB'
          }
        },
        data: pieData
      }
    ]
  };

  extPieChartInstance.setOption(option);
  extPieChartInstance.on('click', (params) => {
    const ext = params.data.rawExt;
    if (ext) {
      const extBtn = document.querySelector(`.popover-ext-btn[data-ext="${ext}"]`);
      if (extBtn) extBtn.click();
      else { $('q').value = ext; search(1); }
    }
  });
}

function showHomeCockpit() {
  const cockpit = $('homeDataCockpit');
  const ws = $('searchWorkspaceLayout');
  if (cockpit) cockpit.classList.remove('hidden');
  if (ws) ws.classList.add('hidden');
  setTimeout(() => {
    if (deptChartInstance) deptChartInstance.resize();
    if (extPieChartInstance) extPieChartInstance.resize();
  }, 60);
}

function hideHomeCockpit() {
  const cockpit = $('homeDataCockpit');
  const ws = $('searchWorkspaceLayout');
  if (cockpit) cockpit.classList.add('hidden');
  if (ws) ws.classList.remove('hidden');
}

function selectDepartmentSearch(deptName) {
  $('q').value = deptName;
  search(1);
}

// 重写 toggleAIChat 支持全屏毛玻璃遮罩抽屉
function toggleAIChat(forceOpen) {
  const overlay = $('aiDrawerOverlay');
  if (!overlay) return;
  const willOpen = forceOpen !== undefined ? forceOpen : overlay.classList.contains('hidden');
  if (willOpen) {
    overlay.classList.remove('hidden');
    setTimeout(() => $('aiInput')?.focus(), 150);
  } else {
    overlay.classList.add('hidden');
  }
}

// 选中并呈现资产画像 Inspector
function selectAndInspectResult(idx) {
  selectedResultIndex = idx;
  document.querySelectorAll('.result-card').forEach((el, i) => {
    el.classList.toggle('selected', i === idx);
  });
  const r = lastResults[idx];
  if (!r) { renderInspectorEmpty(); return; }
  renderInspectorDetail(r);
}

function renderInspectorEmpty() {
  const emp = $('inspectorEmptyState');
  const act = $('inspectorActiveContent');
  if (emp) emp.style.display = 'block';
  if (act) act.style.display = 'none';
}

function renderInspectorDetail(r) {
  const emp = $('inspectorEmptyState');
  const act = $('inspectorActiveContent');
  if (emp) emp.style.display = 'none';
  if (act) act.style.display = 'flex';

  const ext = (r.ext || '').replace('.', '').toLowerCase();
  const dept = (r.parent || '').split('/').slice(-1)[0] || '根目录';
  const hasData = (r.size || 0) > 0;
  const timeInfo = fmtDate(r.mtime);

  act.innerHTML = `
    <div class="inspector-header">
      <div class="inspector-title-row">
        <div class="inspector-filename" title="${esc(r.name)}">${esc(r.name)}</div>
        <button class="inspector-expand-btn" onclick="previewFile(${r.id})" title="全屏工作台查看">↗</button>
      </div>
      <div class="inspector-meta-row">
        <span class="dept-pill">📁 ${esc(dept)}</span>
        <span>·</span>
        <span>${fmtBytes(r.size)}</span>
        <span>·</span>
        <span>${timeInfo.rel || timeInfo.full}</span>
      </div>
      <div class="inspector-quick-actions">
        <button class="btn-action-primary" style="padding:4px 10px;font-size:11.5px" onclick="openFileLocally(${r.id})">📂 本机应用打开</button>
        <button class="btn-action-secondary" style="padding:4px 10px;font-size:11.5px" onclick="handleSearchDownload(${selectedResultIndex})">⬇ 下载</button>
        <button class="btn-action-secondary" style="padding:4px 10px;font-size:11.5px" onclick="copyUncPath(${selectedResultIndex})">⧉ 复制路径</button>
      </div>
    </div>

    <!-- 3 个核心 KPI 画像卡片 -->
    <div class="inspector-kpi-deck">
      <div class="inspector-kpi-tile">
        <div class="kpi-tile-label">记录规模</div>
        <div class="kpi-tile-val" id="inspKpiRows">${hasData ? '读取中…' : '0 行'}</div>
      </div>
      <div class="inspector-kpi-tile">
        <div class="kpi-tile-label">字段维度</div>
        <div class="kpi-tile-val" id="inspKpiCols">${hasData ? '读取中…' : '-'}</div>
      </div>
      <div class="inspector-kpi-tile">
        <div class="kpi-tile-label">数据状态</div>
        <div class="kpi-tile-val" style="color:var(--emerald)">${hasData ? '结构化就绪' : '0字节占位'}</div>
      </div>
    </div>

    <!-- Sheet Tabs 与 切片表格 -->
    <div class="inspector-tabs-wrap">
      <div class="inspector-tabs-bar" id="inspSheetTabs">
        <button class="sheet-tab-btn active">数据切片</button>
      </div>
    </div>
    <div class="inspector-table-viewport" id="inspViewport">
      ${hasData 
        ? '<div style="padding:30px;text-align:center;color:var(--muted);font-size:12px">⚡ 正在毫秒级提取数据样本切片...</div>'
        : '<div style="padding:30px;text-align:center;color:var(--subtle);font-size:12px">此文件为 0 字节模拟占位文件，暂无实体数据单元格。</div>'
      }
    </div>
  `;

  if (hasData) {
    loadInspectorSheetSnippet(r.id, r.name);
  }
}

async function loadInspectorSheetSnippet(fileId, fileName) {
  try {
    const res = await fetch(`/api/file/${fileId}/preview-source/${encodeURIComponent(fileName)}`);
    if (!res.ok) throw new Error('读取预览字节流失败');
    const buf = await res.arrayBuffer();
    const wb = XLSX.read(buf, { type: 'array' });
    currentWorkbookCache = wb;

    if (wb.SheetNames && wb.SheetNames.length) {
      renderInspSheetTabs(wb.SheetNames, 0);
      renderInspSheetTable(wb.SheetNames[0]);
    }
  } catch (err) {
    const vp = $('inspViewport');
    if (vp) vp.innerHTML = `<div style="padding:24px;color:var(--rose);font-size:11.5px">切片加载失败: ${esc(err.message)}</div>`;
  }
}

function renderInspSheetTabs(names, activeIdx) {
  const tabs = $('inspSheetTabs');
  if (!tabs) return;
  tabs.innerHTML = names.map((name, idx) => `
    <button class="sheet-tab-btn ${idx === activeIdx ? 'active' : ''}" onclick="switchInspSheet(${idx})">${esc(name)}</button>
  `).join('');
}

function switchInspSheet(idx) {
  if (!currentWorkbookCache) return;
  const name = currentWorkbookCache.SheetNames[idx];
  renderInspSheetTabs(currentWorkbookCache.SheetNames, idx);
  renderInspSheetTable(name);
}

function renderInspSheetTable(sheetName) {
  if (!currentWorkbookCache) return;
  const sheet = currentWorkbookCache.Sheets[sheetName];
  const jsonRows = XLSX.utils.sheet_to_json(sheet, { header: 1 });
  const vp = $('inspViewport');
  if (!vp) return;

  if (jsonRows && jsonRows.length > 0) {
    const headers = jsonRows[0] || [];
    const bodyRows = jsonRows.slice(1, 12);

    if ($('inspKpiRows')) $('inspKpiRows').textContent = `${jsonRows.length - 1} 行`;
    if ($('inspKpiCols')) $('inspKpiCols').textContent = `${headers.length} 列`;

    let html = '<table class="snippet-table"><thead><tr>';
    headers.forEach(h => { html += `<th>${esc(h)}</th>`; });
    html += '</tr></thead><tbody>';
    bodyRows.forEach(row => {
      html += '<tr>';
      headers.forEach((_, colIdx) => {
        html += `<td>${esc(row[colIdx] != null ? row[colIdx] : '')}</td>`;
      });
      html += '</tr>';
    });
    html += '</tbody></table>';
    vp.innerHTML = html;
  } else {
    vp.innerHTML = '<div style="padding:20px;text-align:center;color:var(--muted);font-size:11px">该工作表暂无可视数据</div>';
  }
}

// 键盘方向键无缝切表
document.addEventListener('keydown', (e) => {
  if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
  if (e.key === 'Escape') { toggleAIChat(false); }
  if (lastResults && lastResults.length) {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (selectedResultIndex < lastResults.length - 1) {
        selectAndInspectResult(selectedResultIndex + 1);
        const el = document.querySelector(`.result-card[data-idx="${selectedResultIndex}"]`);
        if (el) el.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (selectedResultIndex > 0) {
        selectAndInspectResult(selectedResultIndex - 1);
        const el = document.querySelector(`.result-card[data-idx="${selectedResultIndex}"]`);
        if (el) el.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
    } else if (e.key === 'Enter') {
      if (lastResults[selectedResultIndex]) openFileLocally(lastResults[selectedResultIndex].id);
    } else if (e.key === ' ') {
      e.preventDefault();
      if (lastResults[selectedResultIndex]) previewFile(lastResults[selectedResultIndex].id);
    }
  }
});

window.addEventListener('resize', () => {
  if (deptChartInstance) deptChartInstance.resize();
  if (extPieChartInstance) extPieChartInstance.resize();
});

// 页面加载完毕初始化大屏
window.addEventListener('DOMContentLoaded', () => {
  initHomeDataCockpit();
});

</script>
</body>
</html>