async function locateInCatalog(dirPath) {
  switchNavMode('catalog');
  if (!catalogState.tree) {
    await initCatalogDashboard();
  }
  if (!dirPath) return;

  const rootPrefix = '/data/share';
  let cur = rootPrefix;
  const rel = dirPath.startsWith(rootPrefix) ? dirPath.slice(rootPrefix.length).trim() : dirPath;
  const parts = rel.split('/').filter(Boolean);
  catalogState.expandedPaths.add(rootPrefix);
  parts.forEach(p => {
    cur += '/' + p;
    catalogState.expandedPaths.add(cur);
  });

  const targetNode = findNodeByPath(catalogState.tree, dirPath);
  if (targetNode) {
    selectTreeNode(targetNode.path, targetNode.name, targetNode.file_count, targetNode.today_added);
    renderCatalogTree();
    toast(`已在组织架构树中直达【${targetNode.name}】`);
  }
}

