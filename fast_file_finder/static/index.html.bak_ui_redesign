function esc(v) {
  return String(v ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}
function fmtBytes(n) {
  if (n == null || !Number.isFinite(Number(n))) return '—';
  n = Number(n);
  if (n === 0) return '0 B';
  const u = ['B', 'KB', 'MB', 'GB', 'TB'];
  let i = 0;
  while (n >= 1024 && i < u.length - 1) { n /= 1024; i++; }
  return n.toFixed(i ? 1 : 0) + ' ' + u[i];
}
function fmtNumber(n) {
  if (n === null || n === undefined || n === '' || !Number.isFinite(Number(n))) return '—';
  return Number(n).toLocaleString('zh-CN', { maximumFractionDigits: 2 });
}
function fmtDate(ts) {
  if (!ts) return { full: '—', rel: '未知' };
  const d = new Date(Number(ts) * 1000);
  const now = new Date();
  const diffDays = Math.floor((now - d) / (1000 * 60 * 60 * 24));
  let rel = '';
  if (diffDays <= 0) rel = '今天';
  else if (diffDays === 1) rel = '昨天';
  else if (diffDays < 7) rel = `${diffDays}天前`;
  else if (diffDays < 30) rel = `${Math.floor(diffDays/7)}周前`;
  else rel = `${Math.floor(diffDays/30)}月前`;
  
  const pad = n => String(n).padStart(2, '0');
  const full = `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
  return { full, rel };
}
function extClass(ext) {
  ext = (ext || '').toLowerCase();
  if (ext === '.xlsx' || ext === '.xls') return 'xlsx';
  if (ext === '.csv' || ext === '.tsv') return 'csv';
  if (ext === '.xlsm') return 'xlsm';
  return 'other';
}

async function api(url, opts = {}) {
  const token = sessionStorage.getItem('fileFinderAccessToken') || '';
  const headers = { ...(opts.headers || {}) };
  let body = opts.body;
  if (body !== undefined && !headers['Content-Type']) {
    if (typeof body === 'object' && !(body instanceof FormData)) {
      headers['Content-Type'] = 'application/json';
      body = JSON.stringify(body);
    } else if (typeof body === 'string' && (body.trim().startsWith('{') || body.trim().startsWith('['))) {
      headers['Content-Type'] = 'application/json';
    }
  }
  if (token) headers['X-App-Token'] = token;

  const timeoutMs = opts.timeoutMs || 15000;
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), timeoutMs);

  try {
    const res = await fetch(url, { ...opts, headers, body, signal: controller.signal });
    clearTimeout(timer);
    const data = (res.headers.get('content-type') || '').includes('application/json') ? await res.json() : await res.text();
    const rawDetail = data?.detail || data?.message;
    const errText = typeof rawDetail === 'object' ? (Array.isArray(rawDetail) ? rawDetail.map(d => d.msg || JSON.stringify(d)).join('; ') : JSON.stringify(rawDetail)) : rawDetail;
    if (res.status === 401 && String(errText || '').includes('登录')) showLoginOverlay();
    if (!res.ok) throw new Error(errText || `服务响应异常 (${res.status})`);
    return data;
  } catch (err) {
    clearTimeout(timer);
    if (err.name === 'AbortError') {
      throw new Error(`请求超时 (${timeoutMs / 1000}s)，请检查网络连接或稍后重试`);
    }
    throw err;
  }
}

/* 现代化分页条渲染 */
function renderPagination() {
