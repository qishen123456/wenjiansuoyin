async function loadCatalogTree() {
  const container = $('catalogTreeContainer');
  container.innerHTML = `
    <div style="padding:40px;text-align:center;color:#94a3b8;font-size:13px">
      <span class="spinner-anim" style="border-color:#2563eb;border-top-color:transparent;width:18px;height:18px"></span>
      <div style="margin-top:8px">正在构建组织架构树…</div>
    </div>`;

  try {
    const res = await api(`/api/catalog/tree?only_today_branch=${catalogState.filterOnlyToday}`);
    if (!res.ok) return;
    catalogState.tree = res.tree;

    // 默认展开一级节点
    if (res.tree?.children) {
      res.tree.children.forEach(c => catalogState.expandedPaths.add(c.path));
    }

    renderCatalogTree();

    // 默认选中第一个活跃或主要节点
    if (!catalogState.selectedNode && res.tree?.children?.length) {
      const firstChild = res.tree.children[0];
      selectTreeNode(firstChild.path, firstChild.name, firstChild.file_count, firstChild.today_added);
