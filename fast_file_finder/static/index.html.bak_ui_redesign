<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>企业文件资产智能检索中心 · Enterprise Data Portal</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<script src="/static/echarts.min.js"></script>
<script src="/static/xlsx.full.min.js"></script>
<style>

:root {
  --canvas: #F8FAFC;
  --surface: #FFFFFF;
  --surface-subtle: #F1F5F9;
  --surface-hover: #F8FAFC;
  
  --ink: #0F172A;
  --ink-secondary: #334155;
  --muted: #64748B;
  --subtle: #94A3B8;
  --faint: #CBD5E1;
  
  --line: rgba(226, 232, 240, 0.9);
  --line-strong: #CBD5E1;
  --line-focus: #3B82F6;
  
  --brand: #2563EB;
  --brand-hover: #1D4ED8;
  --brand-subtle: #EFF6FF;
  --brand-ring: rgba(37, 99, 235, 0.16);
  
  --emerald: #059669;
  --emerald-subtle: #ECFDF5;
  --emerald-line: #A7F3D0;
  
  --amber: #D97706;
  --amber-subtle: #FFFBEB;
  --amber-line: #FDE68A;
  
  --rose: #E11D48;
  --rose-subtle: #FFF1F2;
  --rose-line: #FECDD3;

  --purple: #7C3AED;
  --purple-subtle: #F5F3FF;
  --purple-line: #DDD6FE;
  
  --shadow-xs: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
  --shadow-sm: 0 2px 6px 0 rgba(15, 23, 42, 0.04), 0 1px 2px 0 rgba(15, 23, 42, 0.03);
  --shadow-md: 0 6px 16px -2px rgba(15, 23, 42, 0.06), 0 2px 6px -1px rgba(15, 23, 42, 0.03);
  --shadow-lg: 0 14px 28px -4px rgba(15, 23, 42, 0.08), 0 4px 10px -2px rgba(15, 23, 42, 0.03);
  --shadow-xl: 0 24px 48px -8px rgba(15, 23, 42, 0.16);
  
  --radius-xs: 4px;
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 14px;
  --radius-xl: 18px;
  
  --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", "Microsoft YaHei", sans-serif;
  --font-mono: 'JetBrains Mono', SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  min-height: 100vh;
  background-color: var(--canvas);
  font-family: var(--font-sans);
  color: var(--ink-secondary);
  font-size: 13.5px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

button, input, select, textarea { font-family: inherit; font-size: inherit; outline: none; }
button { cursor: pointer; transition: all 0.12s ease; }
button:disabled { cursor: not-allowed; opacity: 0.5; }

/* 页面统一骨架 */
.app-root {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 1. 现代化极简顶栏 Header (56px, Linear/Vercel 级通透设计) */
.topbar {
  height: 56px;
  min-height: 56px;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--line);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32px;
  position: sticky;
  top: 0;
  z-index: 90;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
}
.topbar-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  user-select: none;
}
.brand-logo {
  width: 32px;
  height: 32px;
  background: linear-gradient(135deg, #1E293B, #0F172A);
  color: #FFF;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 14px;
  box-shadow: 0 2px 6px rgba(15, 23, 42, 0.18);
}
.brand-info h1 {
  font-size: 14px;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.2px;
}
.brand-info p {
  font-size: 11px;
  color: var(--muted);
}

/* 顶部唯一主导航 (Segmented Control) */
.nav-mode-tabs {
  display: flex;
  align-items: center;
  background: #EEF2F6;
  padding: 4px;
  border-radius: var(--radius-md);
  border: 1px solid var(--line);
  gap: 3px;
}
.nav-mode-btn {
  padding: 6px 16px;
  font-size: 12.5px;
  font-weight: 600;
  color: var(--muted);
  border: none;
  background: transparent;
  border-radius: var(--radius-sm);
  display: inline-flex;
  align-items: center;
  gap: 6px;
  position: relative;
  transition: all 0.15s ease;
}
.nav-mode-btn:hover { color: var(--ink); }
.nav-mode-btn.active {
  background: #FFFFFF;
  color: var(--brand);
  font-weight: 700;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06);
}
.nav-dot-badge {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--rose);
}

/* 顶栏右侧状态与操作 */
.topbar-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}
.server-status-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  border-radius: 20px;
  font-size: 11.5px;
  font-weight: 600;
  background: var(--emerald-subtle);
  color: var(--emerald);
  border: 1px solid var(--emerald-line);
}
.status-indicator-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--emerald);
  box-shadow: 0 0 0 2px rgba(5, 150, 105, 0.25);
}
.status-refresh-icon {
  border: none; background: transparent; color: var(--emerald); display: flex; align-items: center; cursor: pointer;
}
.btn-ai-header {
  height: 32px;
  padding: 0 12px;
  border-radius: var(--radius-sm);
  background: linear-gradient(135deg, #1E293B, #0F172A);
  color: #FFF;
  border: none;
  font-size: 12px;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  box-shadow: 0 2px 6px rgba(15, 23, 42, 0.15);
  transition: all 0.15s;
}
.btn-ai-header:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(15, 23, 42, 0.25);
}
.btn-ai-header kbd {
  font-size: 10px;
  font-family: var(--font-mono);
  background: rgba(255, 255, 255, 0.18);
  padding: 1px 5px;
  border-radius: 4px;
}
.user-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 12px;
  background: #FFFFFF;
  border: 1px solid var(--line);
  border-radius: 20px;
  font-size: 11.5px;
  box-shadow: var(--shadow-xs);
}
.user-avatar {
  width: 20px; height: 20px;
  border-radius: 50%;
  background: var(--brand);
  color: #FFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  font-weight: 700;
}
.user-role { font-size: 10px; color: var(--muted); background: #E2E8F0; padding: 1px 6px; border-radius: 4px; }
.user-logout { border: none; background: transparent; color: var(--muted); cursor: pointer; font-size: 11px; }
.user-logout:hover { color: var(--rose); }

/* 2. 主视口 Shell (自适应宽幅与呼吸感) */
.shell {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 24px 32px 48px 32px;
  max-width: 1400px;
  width: 100%;
  margin: 0 auto;
}
.hidden { display: none !important; }

/* 3. 首页 · 智能搜索区 (Hero Focus 居中通栏) */
.search-hero-wrap {
  display: flex;
  flex-direction: column;
  gap: 12px;
  width: 100%;
  margin-bottom: 24px;
}
.command-search-frame {
  height: 54px;
  background: #FFFFFF;
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-lg);
  padding: 0 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05), 0 1px 3px rgba(15, 23, 42, 0.03);
  transition: all 0.2s ease;
}
.command-search-frame:focus-within {
  border-color: var(--line-focus);
  box-shadow: 0 0 0 4px var(--brand-ring), 0 8px 24px -4px rgba(37, 99, 235, 0.12);
}
.search-prefix-icon {
  width: 20px; height: 20px;
  fill: none;
  stroke: var(--subtle);
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
  flex-shrink: 0;
}
#q {
  flex: 1;
  border: none;
  background: transparent;
  font-size: 15px;
  font-family: inherit;
  color: var(--ink);
  font-weight: 500;
}
.search-clear {
  padding: 3px 7px;
  font-size: 11px;
  background: var(--surface-subtle);
  color: var(--subtle);
  border-radius: 4px;
  border: none;
  cursor: pointer;
}
.kbd-badge {
  font-family: var(--font-mono);
  font-size: 11px;
  padding: 3px 7px;
  background: var(--surface-subtle);
  border: 1px solid var(--line);
  border-radius: 5px;
  color: var(--muted);
  cursor: pointer;
}
.btn-filter-toggle {
  height: 36px;
  padding: 0 12px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--line);
  background: var(--surface-subtle);
  color: var(--ink-secondary);
  font-size: 12px;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  transition: all 0.12s;
}
.btn-filter-toggle svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2; }
.btn-filter-toggle:hover { background: #E2E8F0; }
.btn-hero-search {
  height: 38px;
  padding: 0 20px;
  border-radius: var(--radius-sm);
  background: var(--brand);
  color: #FFF;
  border: none;
  font-size: 13.5px;
  font-weight: 700;
  cursor: pointer;
  flex-shrink: 0;
  box-shadow: 0 2px 6px rgba(37, 99, 235, 0.25);
  transition: all 0.15s;
}
.btn-hero-search:hover {
  background: var(--brand-hover);
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
}

/* Filter 下拉 Popover (完整继承) */
.filter-popover {
  position: absolute;
  top: 48px;
  right: 0;
  width: 340px;
  background: #FFFFFF;
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-xl);
  padding: 16px;
  z-index: 200;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.filter-popover-title {
  font-size: 11px;
  font-weight: 700;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.4px;
}
.filter-popover-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 6px;
}
.popover-ext-btn {
  height: 28px;
  border-radius: var(--radius-xs);
  border: 1px solid var(--line);
  background: var(--surface-subtle);
  color: var(--ink-secondary);
  font-size: 11.5px;
  font-weight: 600;
}
.popover-ext-btn:hover { background: #E2E8F0; }
.popover-ext-btn.active {
  background: var(--brand-subtle);
  border-color: var(--brand);
  color: var(--brand);
  font-weight: 700;
}
.seg-pill-btn.active {
  background: var(--brand) !important;
  color: #FFF !important;
  border-color: var(--brand) !important;
}

/* 热搜推荐文字链 */
.search-prompts-bar {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 12px;
  color: var(--subtle);
  padding: 0 4px;
  flex-wrap: wrap;
}
.prompt-label { font-size: 11.5px; color: var(--muted); font-weight: 600; flex-shrink: 0; }
.prompt-pill-link {
  background: transparent;
  border: none;
  color: var(--ink-secondary);
  cursor: pointer;
  font-size: 12px;
  padding: 2px 6px;
  border-radius: 4px;
  font-weight: 500;
  transition: all 0.12s;
}
.prompt-pill-link:hover { color: var(--brand); background: var(--brand-subtle); }

/* 4. 首页大屏文件数据统计驾驶舱 (Home Data Cockpit) */
.home-cockpit-wrap {
  background: #FFFFFF;
  border: 1px solid var(--line);
  border-radius: var(--radius-xl);
  padding: 24px 28px;
  box-shadow: 0 4px 24px -2px rgba(15, 23, 42, 0.04), 0 1px 3px rgba(15, 23, 42, 0.02);
  display: flex;
  flex-direction: column;
  gap: 20px;
  width: 100%;
}
.cockpit-header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.cockpit-title-group {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}
.cockpit-badge {
  background: var(--brand-subtle);
  color: var(--brand);
  font-size: 11.5px;
  font-weight: 700;
  padding: 3px 9px;
  border-radius: 6px;
}
.cockpit-heading {
  font-size: 16px;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: -0.3px;
}
.cockpit-sub {
  font-size: 12px;
  color: var(--muted);
}
.cockpit-actions {
  display: flex;
  gap: 8px;
}

/* 4 大核心 KPI 指标卡 (自适应横向分布，min-width: 0 杜绝截断) */
.cockpit-kpi-deck {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  width: 100%;
}
.cockpit-kpi-card {
  min-width: 0;
  background: #FFFFFF;
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  padding: 16px 18px;
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: all 0.15s ease;
}
.cockpit-kpi-card:hover {
  background: #FFF;
  border-color: var(--brand);
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}
.cockpit-kpi-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
}
.cockpit-kpi-card.blue::before { background: var(--brand); }
.cockpit-kpi-card.emerald::before { background: var(--emerald); }
.cockpit-kpi-card.purple::before { background: var(--purple); }
.cockpit-kpi-card.amber::before { background: var(--amber); }

.kpi-card-inner {
  display: flex;
  align-items: center;
  gap: 14px;
  width: 100%;
  min-width: 0;
}
.kpi-icon-pill {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  flex-shrink: 0;
}
.kpi-title-text {
  font-size: 11.5px;
  font-weight: 600;
  color: var(--muted);
  white-space: nowrap;
}
.kpi-value-text {
  font-size: 26px;
  font-weight: 800;
  color: var(--ink);
  font-family: var(--font-mono);
  line-height: 1.2;
  margin-top: 2px;
}
.kpi-sub-text {
  font-size: 11px;
  color: var(--subtle);
  margin-top: 2px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ECharts 图表容器 */
.cockpit-charts-grid {
  display: grid;
  grid-template-columns: 1.55fr 1fr;
  gap: 18px;
  width: 100%;
}
.chart-card-panel {
  background: #F8FAFC;
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  padding: 16px 18px;
  display: flex;
  flex-direction: column;
}
.chart-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
}
.chart-card-title {
  font-size: 13px;
  font-weight: 700;
  color: var(--ink);
  display: flex;
  align-items: center;
  gap: 6px;
}
.chart-hint-tag {
  font-size: 11px;
  color: var(--brand);
  background: #FFFFFF;
  padding: 2px 8px;
  border-radius: 4px;
  border: 1px solid rgba(37, 99, 235, 0.2);
  font-weight: 600;
}

/* 直达矩阵卡片 (双行排版，彻底消除单行省略号) */
.cockpit-matrix-section {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.matrix-title {
  font-size: 12px;
  font-weight: 700;
  color: var(--ink);
}
.matrix-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 10px;
  width: 100%;
}
.matrix-card-item {
  background: #F8FAFC;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  padding: 10px 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  cursor: pointer;
  transition: all 0.15s ease;
  min-width: 0;
}
.matrix-card-item:hover {
  background: #FFFFFF;
  border-color: var(--brand);
  box-shadow: var(--shadow-sm);
  transform: translateY(-2px);
}
.matrix-item-left {
  display: flex;
  align-items: center;
  gap: 6px;
  min-width: 0;
}
.matrix-badge-icon { font-size: 13px; flex-shrink: 0; }
.matrix-item-name {
  font-size: 12px;
  font-weight: 700;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.matrix-item-count {
  font-size: 11px;
  font-family: var(--font-mono);
  color: var(--brand);
  font-weight: 700;
  margin-left: 19px;
}

/* 5. 检索结果工作台 (Master-Detail 双流工业布局) */
.search-workspace-layout {
  display: flex;
  flex-direction: column;
  gap: 16px;
  width: 100%;
}
.search-status-bar {
  height: 42px;
  background: #FFFFFF;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  padding: 0 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: var(--shadow-xs);
}
.status-left {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 12.5px;
  color: var(--muted);
}
.status-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--emerald);
}
.timing-badge {
  font-family: var(--font-mono);
  color: var(--emerald);
  font-weight: 700;
}
.btn-back-cockpit {
  padding: 5px 12px;
  border-radius: var(--radius-sm);
  background: var(--surface-subtle);
  border: 1px solid var(--line);
  color: var(--ink-secondary);
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.12s;
}
.btn-back-cockpit:hover { background: #E2E8F0; color: var(--brand); }

/* Master-Detail 并排核心网格 */
.master-detail-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(400px, 1fr);
  gap: 20px;
  align-items: start;
}
.results-stream-pane {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.inspector-detail-pane {
  display: flex;
  flex-direction: column;
  gap: 16px;
  min-width: 0;
}

/* 结果面板 */
.panel {
  background: #FFFFFF;
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-xs);
  overflow: hidden;
}
.results-header {
  padding: 14px 20px;
  border-bottom: 1px solid var(--line);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.results-header h3 {
  font-size: 13.5px;
  font-weight: 700;
  color: var(--ink);
}

/* 紧凑 52px 结果行 + 悬浮微动作胶囊 */
.result-card {
  height: 52px;
  display: flex;
  align-items: center;
  padding: 0 18px;
  border-bottom: 1px solid var(--line);
  background: #FFFFFF;
  position: relative;
  cursor: pointer;
  transition: background 0.1s;
}
.result-card:hover { background: var(--canvas); }
.result-card.selected { background: var(--brand-subtle); }
.result-card.selected::before {
  content: '';
  position: absolute;
  left: 0;
  top: 10px;
  bottom: 10px;
  width: 3px;
  background: var(--brand);
  border-radius: 0 2px 2px 0;
}
.file-badge-icon {
  width: 36px;
  height: 24px;
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  font-weight: 700;
  font-family: var(--font-mono);
  margin-right: 14px;
  flex-shrink: 0;
}
.file-badge-icon.xlsx, .file-badge-icon.xls { background: #E6F4EA; color: #137333; }
.file-badge-icon.csv { background: #E8F0FE; color: #1A73E8; }
.file-badge-icon.other { background: #F1F3F4; color: #5F6368; }

.card-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 2px;
}
.card-title-row {
  display: flex;
  align-items: center;
  gap: 8px;
  white-space: nowrap;
  overflow: hidden;
}
.card-file-name {
  font-size: 13.5px;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.result-card.selected .card-file-name { color: var(--brand); }
.badge-real-data {
  padding: 1px 6px;
  border-radius: 4px;
  font-size: 9.5px;
  font-weight: 700;
  background: #DCFCE7;
  color: #15803D;
  flex-shrink: 0;
}
.score-badge {
  padding: 1px 5px;
  border-radius: 3px;
  font-size: 9px;
  font-weight: 600;
  background: #F1F5F9;
  color: var(--muted);
  flex-shrink: 0;
}
.card-path-row { display: none; }
.card-meta-row {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 11.5px;
  color: var(--muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.meta-time-badge { margin-left: 3px; color: var(--subtle); }
.match-tag { color: var(--subtle); font-size: 11px; }

/* 悬浮微动作胶囊 */
.card-actions {
  position: absolute;
  right: 14px;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  gap: 5px;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.12s ease;
  background: #FFFFFF;
  padding: 3px 6px;
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--line);
}
.result-card:hover .card-actions { opacity: 1; pointer-events: auto; }
.card-actions button {
  padding: 3px 8px;
  font-size: 11px;
  font-weight: 600;
  border-radius: var(--radius-xs);
  border: 1px solid var(--line);
  background: #FFF;
  color: var(--ink-secondary);
  white-space: nowrap;
}
.card-actions button:hover {
  background: var(--canvas);
  border-color: var(--line-strong);
  color: var(--ink);
}
.card-actions .btn-action-primary {
  background: var(--brand) !important;
  color: #FFF !important;
  border-color: var(--brand) !important;
}

/* 6. 右侧资产画像 Inspector (Detail) */
.inspector-card {
  min-height: 440px;
  display: flex;
  flex-direction: column;
}
.inspector-empty {
  padding: 56px 24px;
  text-align: center;
  color: var(--muted);
}
.inspector-active {
  display: flex;
  flex-direction: column;
  height: 100%;
}
.inspector-header {
  padding: 16px 20px 14px 20px;
  border-bottom: 1px solid var(--line);
  background: #FAFAFA;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.inspector-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;
}
.inspector-filename {
  font-size: 14px;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.35;
  word-break: break-all;
}
.inspector-expand-btn {
  padding: 3px 8px;
  border: 1px solid var(--line);
  background: #FFF;
  border-radius: 4px;
  font-size: 11px;
}
.inspector-meta-row {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11.5px;
  color: var(--muted);
}
.dept-pill {
  background: #E2E8F0;
  color: #334155;
  padding: 2px 8px;
  border-radius: 4px;
  font-weight: 600;
}
.inspector-quick-actions {
  display: flex;
  gap: 8px;
  margin-top: 4px;
}

.inspector-kpi-deck {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  padding: 14px 20px;
  border-bottom: 1px solid var(--line);
  background: #FFF;
}
.inspector-kpi-tile {
  background: var(--surface-subtle);
  border-radius: var(--radius-sm);
  padding: 8px 12px;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.kpi-tile-label { font-size: 10.5px; color: var(--muted); font-weight: 600; }
.kpi-tile-val { font-size: 14px; font-weight: 700; color: var(--ink); font-family: var(--font-mono); }

.inspector-tabs-wrap {
  background: #F1F5F9;
  border-bottom: 1px solid var(--line);
  padding: 0 14px;
}
.inspector-tabs-bar {
  display: flex;
  align-items: center;
  gap: 4px;
  overflow-x: auto;
}
.sheet-tab-btn {
  height: 30px;
  padding: 0 14px;
  border-radius: 4px 4px 0 0;
  border: none;
  background: transparent;
  font-size: 11.5px;
  font-weight: 600;
  color: var(--muted);
  white-space: nowrap;
}
.sheet-tab-btn.active {
  background: #FFF;
  color: var(--brand);
  font-weight: 700;
}

.inspector-table-viewport {
  flex: 1;
  max-height: 280px;
  overflow: auto;
  background: #FFF;
}
.snippet-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 11px;
}
.snippet-table th {
  position: sticky;
  top: 0;
  background: #F8FAFC;
  padding: 7px 12px;
  font-weight: 700;
  color: #475569;
  border-bottom: 1px solid var(--line-strong);
  border-right: 1px solid var(--line);
  white-space: nowrap;
  text-align: left;
}
.snippet-table td {
  padding: 7px 12px;
  border-bottom: 1px solid var(--line);
  border-right: 1px solid var(--line);
  color: var(--ink-secondary);
  white-space: nowrap;
  max-width: 180px;
  overflow: hidden;
  text-overflow: ellipsis;
}
.snippet-table tr:hover td { background: #F8FAFC; }

/* 盘库小部件与最近更新 */
.stat-sub-panel {
  padding: 16px 20px;
}
.stat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 7px 0;
  border-bottom: 1px solid var(--line);
}
.stat-label { font-size: 12px; color: var(--muted); font-weight: 500; }
.stat-value { font-family: var(--font-mono); font-size: 13.5px; font-weight: 700; color: var(--ink); }

/* 7. 现代全高抽屉式 AI 寻访浮层 (带全屏暗色毛玻璃遮罩，默认 100% 隐藏，绝不遮挡顶栏) */
.ai-drawer-overlay {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.45);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  z-index: 999;
  display: flex;
  justify-content: flex-end;
  transition: opacity 0.2s ease;
}
.ai-drawer-overlay.hidden {
  display: none !important;
}
.ai-slide-drawer {
  width: 460px;
  max-width: 90vw;
  height: 100vh;
  background: #FFFFFF;
  box-shadow: -10px 0 40px rgba(15, 23, 42, 0.18);
  display: flex;
  flex-direction: column;
  animation: slideInRight 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
}
@keyframes slideInRight {
  from { transform: translateX(100%); }
  to { transform: translateX(0); }
}
.ai-drawer-header {
  padding: 16px 20px;
  background: linear-gradient(135deg, #1E293B, #0F172A);
  color: #FFF;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.ai-drawer-title-group {
  display: flex;
  align-items: center;
  gap: 10px;
}
.ai-star-badge {
  width: 32px;
  height: 32px;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
}
.ai-header-title { font-size: 14px; font-weight: 700; color: #FFF; }
.ai-header-sub { font-size: 10.5px; color: #94A3B8; margin-top: 1px; }
.ai-header-actions { display: flex; align-items: center; gap: 8px; }
.ai-head-btn {
  background: rgba(255, 255, 255, 0.15);
  color: #FFF;
  border: none;
  padding: 4px 10px;
  border-radius: 5px;
  font-size: 11px;
  font-weight: 600;
}
.ai-head-close-btn {
  background: transparent;
  color: #94A3B8;
  border: none;
  font-size: 16px;
  padding: 2px 6px;
  cursor: pointer;
}
.ai-head-close-btn:hover { color: #FFF; }

.ai-drawer-body {
  flex: 1;
  overflow-y: auto;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  background: #F8FAFC;
}
.ai-drawer-footer {
  padding: 14px 20px;
  background: #FFFFFF;
  border-top: 1px solid var(--line);
  display: flex;
  gap: 8px;
}

/* 8. 组织目录树、归档合规、权限、审批视图 (完整继承样式) */
.catalog-shell { display: flex; flex-direction: column; gap: 18px; width: 100%; }
.catalog-kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
.catalog-kpi-card {
  background: #FFFFFF; border: 1px solid var(--line); border-radius: var(--radius-lg);
  padding: 16px 18px; display: flex; gap: 14px; box-shadow: var(--shadow-sm);
}
.kpi-icon-wrap {
  width: 42px; height: 42px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;
}
.kpi-icon-blue { background: #EFF6FF; }
.kpi-icon-green { background: #ECFDF5; }
.kpi-icon-purple { background: #F5F3FF; }
.kpi-icon-orange { background: #FFFBEB; }
.kpi-label { font-size: 12px; color: var(--muted); font-weight: 600; }
.kpi-value { font-size: 22px; font-weight: 800; color: var(--ink); font-family: var(--font-mono); }
.kpi-sub { font-size: 11.5px; color: var(--subtle); }

.catalog-main-layout { display: grid; grid-template-columns: 340px 1fr; gap: 18px; align-items: start; }
.tree-scroll-container { max-height: 600px; overflow-y: auto; padding: 10px 14px; font-size: 12px; }
.catalog-breadcrumb-bar { padding: 12px 16px; background: var(--surface-subtle); border-bottom: 1px solid var(--line); font-size: 12.5px; color: var(--muted); }
.catalog-table-container { overflow-x: auto; }
.catalog-table { width: 100%; border-collapse: collapse; font-size: 12px; }
.catalog-table th { background: var(--surface-subtle); padding: 10px 14px; text-align: left; font-weight: 700; color: #475569; border-bottom: 1px solid var(--line-strong); }
.catalog-table td { padding: 10px 14px; border-bottom: 1px solid var(--line); }
.catalog-table tr:hover td { background: var(--surface-subtle); }
.catalog-pagination-bar { padding: 12px 18px; display: flex; align-items: center; justify-content: space-between; font-size: 12px; color: var(--muted); }

.archive-kpi-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; }
.filter-tabs-group { display: flex; gap: 8px; margin: 14px 0; }
.archive-task-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 14px; }

/* 9. 模态框全量质感统一 */
.modal-overlay {
  position: fixed; inset: 0; background: rgba(15, 23, 42, 0.45); backdrop-filter: blur(6px);
  z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 24px;
}
.modal-window, .modal-card {
  background: #FFFFFF; border-radius: var(--radius-xl); border: 1px solid var(--line);
  box-shadow: var(--shadow-xl); width: 100%; max-width: 560px; display: flex; flex-direction: column; overflow: hidden;
}
.modal-header, .modal-title { padding: 16px 22px; border-bottom: 1px solid var(--line); font-size: 14px; font-weight: 700; color: var(--ink); display: flex; justify-content: space-between; align-items: center; }
.modal-body { padding: 22px; display: flex; flex-direction: column; gap: 14px; max-height: 75vh; overflow-y: auto; }
.modal-btns { padding: 14px 22px; background: var(--surface-subtle); border-top: 1px solid var(--line); display: flex; align-items: center; justify-content: flex-end; gap: 8px; }
.btn-action-primary { background: var(--brand); color: #FFF; border: none; padding: 6px 16px; border-radius: var(--radius-sm); font-size: 12.5px; font-weight: 700; }
.btn-action-secondary { background: #FFF; color: var(--ink-secondary); border: 1px solid var(--line); padding: 6px 16px; border-radius: var(--radius-sm); font-size: 12.5px; font-weight: 600; }

</style>
</head>
<body>

<div class="app-root">
  <!-- 1. 全局唯一定制顶栏 (彻底告别双重导航与右上角遮挡) -->
  <header class="topbar">
    <div class="topbar-brand">
      <div class="brand-logo">EA</div>
      <div class="brand-info">
        <h1>企业文件资产智能检索中心</h1>
        <p>130,452 份报表秒级召回 · 本地磁盘毫秒检索</p>
      </div>
    </div>

    <!-- 顶部唯一导航模式 Tabs (Segmented Control) -->
    <nav class="nav-mode-tabs">
      <button class="nav-mode-btn active" id="navSearchTab" onclick="switchNavMode('search')">
        <span>🔍 首页 · 检索与大屏</span>
      </button>
      <button class="nav-mode-btn" id="navCatalogTab" onclick="switchNavMode('catalog')">
        <span>📁 组织架构全景</span>
      </button>
      <button class="nav-mode-btn" id="navArchiveTab" onclick="switchNavMode('archive')">
        <span>📋 归档合规监控</span>
        <span class="nav-dot-badge" id="navPendingDot" style="display:none"></span>
      </button>
      <button class="nav-mode-btn" id="navApprovalTab" onclick="switchNavMode('approval')">
        <span>🛡 下载审批中心</span>
        <span class="nav-dot-badge" id="navApprovalDot" style="display:none"></span>
      </button>
      <button class="nav-mode-btn" id="navPermTab" onclick="switchNavMode('permission')">
        <span>👥 人员与账号权限</span>
      </button>
    </nav>

    <!-- 顶栏右侧状态与操作 -->
    <div class="topbar-actions">
      <div class="server-status-pill">
        <span class="status-indicator-dot"></span>
        <span>已就绪 130,452 份</span>
        <button class="status-refresh-icon" id="refreshPage" title="刷新状态">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/></svg>
        </button>
      </div>
      <button class="btn-ai-header" onclick="toggleAIChat(true)" title="唤起 AI 寻访抽屉 (⌘J)">
        <span>✨</span> <span>AI 寻访</span> <kbd>⌘J</kbd>
      </button>
      <div class="user-pill" id="userPill" style="display:none">
        <span class="user-avatar" id="userPillAvatar"></span>
        <span id="userPillName"></span>
        <span class="user-role" id="userPillRole"></span>
        <button class="user-logout" onclick="doLogout()" title="退出登录">退出</button>
      </div>
    </div>
  </header>

  <!-- 2. 主视口 Shell -->
  <main class="shell">
    <!-- 视图 1：首页 · 智能搜索 + 全盘文件资产统计大屏 + 检索工作台 -->
    <section id="searchView">
      <!-- 搜索主区域 (居中通栏) -->
      <div class="search-hero-wrap">
        <div class="command-search-frame">
          <svg class="search-prefix-icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input id="q" placeholder="快速检索全盘 13 万份报表、业务线、单号或关键指标 (按 Enter 搜索)..." autocomplete="off">
          <button class="search-clear" id="clearSearch">✕</button>
          <span class="kbd-badge" title="按 ⌘K 快速聚焦" onclick="$('q').focus()">⌘K</span>
          
          <!-- Filter 筛选 Popover -->
          <div style="position:relative">
            <button type="button" id="filterPopoverToggle" onclick="toggleFilterPopover()" class="btn-filter-toggle" title="高级筛选条件">
              <svg viewBox="0 0 24 24"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
              <span>高级筛选</span>
            </button>
            <div class="filter-popover hidden" id="filterPopoverMenu">
                  <div class="filter-popover-title">文件格式筛选</div>
                  <div class="filter-popover-grid">
                    <button class="popover-ext-btn active" data-ext="">全部</button>
                    <button class="popover-ext-btn" data-ext=".xlsx">XLSX</button>
                    <button class="popover-ext-btn" data-ext=".xls">XLS</button>
                    <button class="popover-ext-btn" data-ext=".csv">CSV</button>
                  </div>
                  <div style="padding-top:8px;border-top:1px solid #f1f5f9">
                    <div class="filter-popover-title" style="margin-bottom:6px">匹配模式</div>
                    <div style="display:flex;gap:4px">
                      <button class="seg-pill-btn active" id="btnFilterAnd" data-mode="all" onclick="selectMatchMode('all')" style="flex:1;text-align:center;padding:4px;font-size:11px;border-radius:6px;background:#f8fafc;border:1px solid #e2e8f0">严格匹配 (AND)</button>
                      <button class="seg-pill-btn" id="btnFilterOr" data-mode="any" onclick="selectMatchMode('any')" style="flex:1;text-align:center;padding:4px;font-size:11px;border-radius:6px;background:#f8fafc;border:1px solid #e2e8f0">宽松推荐 (OR)</button>
                    </div>
                  </div>

                  <!-- 日期筛选：快捷标签 + 自定义范围 + 修改/创建切换 -->
                  <div style="padding-top:8px;border-top:1px solid #f1f5f9">
                    <div class="filter-popover-title" style="margin-bottom:6px;display:flex;align-items:center;justify-content:space-between">
                      <span>日期范围</span>
                      <!-- 修改/创建日期切换（放到标题行，节省纵向空间） -->
                      <div id="dateFieldToggle" style="display:flex;background:#f1f5f9;border-radius:6px;padding:1px">
                        <button type="button" data-field="mtime" onclick="setDateField('mtime')" style="height:20px;font-size:10px;border:none;border-radius:4px;background:#fff;color:#2563eb;font-weight:600;cursor:pointer;padding:0 6px;box-shadow:0 1px 2px rgba(0,0,0,0.08)">修改</button>
                        <button type="button" data-field="ctime" onclick="setDateField('ctime')" style="height:20px;font-size:10px;border:none;border-radius:4px;background:transparent;color:#64748b;cursor:pointer;padding:0 6px">创建</button>
                      </div>
                    </div>
                    <!-- 快捷标签：全部 / 今天 / 昨天 / 近3天 / 近7天 / 近30天 / 自定义 -->
                    <div id="dateQuickTags" style="display:flex;flex-wrap:wrap;gap:4px;margin-bottom:6px">
                      <button type="button" data-range="all" onclick="applyDateQuick('all')" style="height:22px;font-size:10.5px;border:1px solid #e2e8f0;border-radius:4px;background:#fff;color:#64748b;cursor:pointer;padding:0 7px">全部</button>
                      <button type="button" data-range="today" onclick="applyDateQuick('today')" style="height:22px;font-size:10.5px;border:1px solid #e2e8f0;border-radius:4px;background:#fff;color:#64748b;cursor:pointer;padding:0 7px">今天</button>
                      <button type="button" data-range="yesterday" onclick="applyDateQuick('yesterday')" style="height:22px;font-size:10.5px;border:1px solid #e2e8f0;border-radius:4px;background:#fff;color:#64748b;cursor:pointer;padding:0 7px">昨天</button>
                      <button type="button" data-range="3d" onclick="applyDateQuick('3d')" style="height:22px;font-size:10.5px;border:1px solid #e2e8f0;border-radius:4px;background:#fff;color:#64748b;cursor:pointer;padding:0 7px">近3天</button>
                      <button type="button" data-range="7d" onclick="applyDateQuick('7d')" style="height:22px;font-size:10.5px;border:1px solid #e2e8f0;border-radius:4px;background:#fff;color:#64748b;cursor:pointer;padding:0 7px">近7天</button>
                      <button type="button" data-range="30d" onclick="applyDateQuick('30d')" style="height:22px;font-size:10.5px;border:1px solid #e2e8f0;border-radius:4px;background:#fff;color:#64748b;cursor:pointer;padding:0 7px">近30天</button>
                    </div>
                    <!-- 自定义日期范围（可手动调整，修改后标签自动切到"自定义"高亮） -->
                    <div style="display:flex;align-items:center;gap:4px">
                      <input type="date" id="dateFromInput" onchange="onDateFilterChange()" style="flex:1;height:26px;font-size:11px;border:1px solid #e2e8f0;border-radius:5px;padding:0 4px;color:#334155;background:#fff" />
                      <span style="font-size:10px;color:#94a3b8">至</span>
                      <input type="date" id="dateToInput" onchange="onDateFilterChange()" style="flex:1;height:26px;font-size:11px;border:1px solid #e2e8f0;border-radius:5px;padding:0 4px;color:#334155;background:#fff" />
                    </div>
                    <div id="dateFilterHint" style="font-size:10px;color:#94a3b8;margin-top:4px">不限日期，全部文件参与检索</div>
                  </div>
                </div>
          </div>
          
          <button class="btn-hero-search" onclick="search(1)">检 索</button>
