            <button class="btn-table-action" onclick="openEditRuleModal(${r.id})" title="修改监控目录或时效周期">✏️ 编辑</button>
            <button class="btn-table-action" onclick="checkSingleRule(${r.id})" title="立即针对此目录执行自检">⚡ 自检</button>
            <button class="btn-table-action" onclick="locateInCatalog('${esc(r.target_path)}')">🌳 定位</button>
            <button class="btn-table-action" style="color:#ef4444" onclick="deleteArchiveRule(${r.id})">删除</button>
          </div>
        </td>
      </tr>
