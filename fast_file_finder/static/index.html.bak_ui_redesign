async function search(page = 1) {
  const q = $('q').value.trim();
  if (!q) { toast('请输入想查找的报表名称或关键词'); $('q').focus(); return; }
  currentPage = (typeof page === 'number' && !isNaN(page) && page >= 1) ? Math.floor(page) : 1;
  currentQuery = q;
  const btn = $('searchBtn');
  if (btn) {
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-anim"></span> 检索中…';
  }
  try {
    const p = new URLSearchParams({
      q,
      page: String(currentPage),
      page_size: String(pageSize),
      ext: selectedExt,
      sort: sortMode,
      match_mode: matchMode,
      target: searchTarget
    });
    if (dateFrom) p.set('date_from', dateFrom);
    if (dateTo) p.set('date_to', dateTo);
    if (dateField) p.set('date_field', dateField);
    const data = await api('/api/search?' + p);
    renderResults(data);
  } catch (e) {
    toast(e.message || '搜索服务异常');
  } finally {
    if (btn) {
      btn.disabled = false;
      btn.innerHTML = '<span>检索文件</span> <span>⚡</span>';
    }
  }
}

async function copyPath(i) {
