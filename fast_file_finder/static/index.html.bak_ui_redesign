let chatHistory = [];

function toggleAIChat(forceOpen) {
  const drawer = $('aiChatDrawer');
  if (!drawer) return;

  const willOpen = forceOpen !== undefined ? forceOpen : drawer.classList.contains('hidden');
  if (willOpen) {
    drawer.classList.remove('hidden');
    setTimeout(() => $('aiInput')?.focus(), 150);
  } else {
    drawer.classList.add('hidden');
  }
}

function toggleAIWideMode() {
  const drawer = $('aiChatDrawer');
  if (!drawer) return;
  const curWidth = drawer.getBoundingClientRect().width;
  const icon = $('aiWideIcon');
  const label = $('aiWideLabel');

  if (curWidth < 680) {
    drawer.style.width = '780px';
    if (icon) icon.textContent = '❐';
    if (label) label.textContent = '标准宽';
    toast('已切换至 780px 宽屏侧栏 (可按住左边缘任意拖拽)');
  } else {
    drawer.style.width = '480px';
    if (icon) icon.textContent = '⛶';
    if (label) label.textContent = '拉宽';
  }
  localStorage.setItem('fileFinderAiDrawerWidth', parseInt(drawer.style.width, 10));
}

// 绑定拖拽拉宽手柄事件
function initResizableAiDrawer() {
  const drawer = $('aiChatDrawer');
  const resizer = $('aiDrawerResizer');
  if (!drawer || !resizer) return;

  // 恢复保存的宽度
  const savedWidth = localStorage.getItem('fileFinderAiDrawerWidth');
  if (savedWidth) {
    const w = parseInt(savedWidth, 10);
    if (w >= 360 && w <= window.innerWidth * 0.85) {
      drawer.style.width = w + 'px';
    }
  }

  let isDragging = false;
  let startX = 0;
  let startWidth = 0;

  resizer.addEventListener('mousedown', (e) => {
    isDragging = true;
    startX = e.clientX;
    startWidth = drawer.getBoundingClientRect().width;
    resizer.classList.add('is-dragging');
    drawer.classList.add('resizing');
    document.body.style.cursor = 'col-resize';
    document.body.style.userSelect = 'none';
    e.preventDefault();
  });

  window.addEventListener('mousemove', (e) => {
    if (!isDragging) return;
    const deltaX = startX - e.clientX;
    let newWidth = startWidth + deltaX;
    const minWidth = 360;
    const maxWidth = Math.floor(window.innerWidth * 0.85);
    if (newWidth < minWidth) newWidth = minWidth;
    if (newWidth > maxWidth) newWidth = maxWidth;
    drawer.style.width = newWidth + 'px';
  });

  window.addEventListener('mouseup', () => {
    if (!isDragging) return;
    isDragging = false;
    resizer.classList.remove('is-dragging');
    drawer.classList.remove('resizing');
    document.body.style.cursor = '';
    document.body.style.userSelect = '';
    const finalWidth = parseInt(drawer.style.width, 10);
    if (finalWidth) {
      localStorage.setItem('fileFinderAiDrawerWidth', finalWidth);
    }
  });
}

