    }

    tbody.innerHTML = archiveState.rules.map(r => `
      <tr>
        <td>
          <div style="font-weight:700;color:#0f172a">${esc(r.name)}</div>
          <div style="font-size:10.5px;color:#94a3b8;margin-top:2px">ID: ${r.id}</div>
        </td>
        <td><span style="font-family:monospace;font-size:11.5px;color:#475569">${esc(r.target_path)}</span></td>
        <td><span class="stat-pill" style="font-size:11px">${esc(r.period_type === 'daily' ? '每日新增' : (r.period_type === 'monthly' ? '每月新增' : `每 ${r.period_days} 天周增`))}</span></td>
