// 格式化提炼事业部名称，彻底消灭省略号截断
function cleanDeptLabel(n) {
  if (!n) return '';
  const parts = n.split('-');
  if (parts.length >= 3) {
    const reg = parts[1].replace('业务部', '').replace('拓展部', '');
    const biz = parts[2].replace('业务部', '').replace('拓展部', '').replace('管理部', '').replace('中心', '');
    return `${reg} · ${biz}`;
  }
  return n.replace(/^\d+-/, '');
}

