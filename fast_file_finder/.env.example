# 必填：填写运行本系统的服务器可以直接访问的网盘目录。
# Windows UNC 示例：FILE_ROOT=\\172.11.111.11\部门共享\报表
# Windows 映射盘示例：FILE_ROOT=Z:\\报表
# macOS/Linux 已挂载目录示例：FILE_ROOT=/Volumes/企业网盘/报表
FILE_ROOT=

# 先只索引 Excel/CSV；可按实际需要增减
ALLOWED_EXTENSIONS=.xlsx,.xls,.xlsm,.xlsb,.csv,.tsv,.ods

# 索引数据库，建议放在本机 SSD，不要放在同一个慢速网盘上
INDEX_DB_PATH=./data/file_index.db

# 可选 AI 语义重排：仅当本地结果为空或匹配度低时触发；只发送最多 30 条索引候选元数据，不上传 Excel 内容。
# 可填写公司内网部署的 OpenAI-compatible 接口地址。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=12

# BI 表格分析安全阈值（超过限制会明确提示，不会无限读取）
MAX_ANALYSIS_FILE_MB=256
MAX_ANALYSIS_ROWS=200000
PREVIEW_ROWS=100