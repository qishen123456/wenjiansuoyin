# 必填：填写运行本系统的服务器可以直接访问的网盘目录。
# Windows UNC 示例：FILE_ROOT=\\172.11.111.11\部门共享\报表
# Windows 映射盘示例：FILE_ROOT=Z:\\报表
# macOS/Linux 已挂载目录示例：FILE_ROOT=/Volumes/企业网盘/报表
# 仓库模拟数据：先运行 python scripts/restore_demo_data.py，再设置 FILE_ROOT=../网盘模拟数据
# 相对 FILE_ROOT 路径始终以本应用目录为基准。
FILE_ROOT=

# 部署到内网供其他员工访问前，建议配置随机长 ASCII 令牌；页面会提示输入，令牌仅保存在当前浏览器会话。
# 这是共享入口保护，不是用户身份认证或文件 ACL；生产环境仍应接入公司 SSO/反向代理。
APP_ACCESS_TOKEN=

# 先只索引 Excel/CSV；可按实际需要增减
ALLOWED_EXTENSIONS=.xlsx,.xls,.xlsm,.xlsb,.csv,.tsv,.ods

# 索引数据库，建议放在本机 SSD，不要放在同一个慢速网盘上
INDEX_DB_PATH=./data/file_index.db

# 可选 AI 语义重排：仅当本地结果为空或匹配度低时触发；只发送最多 30 条索引候选元数据，不上传 Excel 内容。
# 可填写公司内网部署的 OpenAI-compatible 接口地址。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=12

# BI 表格分析安全阈值（超过限制会明确提示，不会无限读取）
MAX_ANALYSIS_FILE_MB=256
MAX_ANALYSIS_ROWS=200000
PREVIEW_ROWS=100
# 目录权限：默认开启，强制登录；普通账号需由超级管理员显式授权
DIRECTORY_ACL_ENABLED=true

# 仅演示环境开启：在已分类业务域生成并滚动保留 7 天的真实 CSV 示例报表
DEMO_MODE=false
# 演示查询随机约 2–4 秒；真实检索更慢时不额外等待。两项设为 0 可关闭。
DEMO_SEARCH_MIN_SECONDS=2
DEMO_SEARCH_MAX_SECONDS=4
# 演示模式下 AI 回答随机约 5–10 秒；模型更慢时不追加等待。
DEMO_AI_MIN_SECONDS=5
DEMO_AI_MAX_SECONDS=10
# 演示刷新随机约 2–4 分钟；两项设为 0 可关闭，实际扫描更慢时不等待。
DEMO_SCAN_MIN_SECONDS=120
DEMO_SCAN_MAX_SECONDS=240

# 扫描：动态目录队列 + 有界文件队列 + 单写库线程
SCAN_WORKERS=4
SCAN_QUEUE_SIZE=1024
SCAN_BATCH_SIZE=300
SCAN_COMMIT_SECONDS=1
# 在线预览只返回分页数据；不代表可下载原件。解析任务最多并发 1 个。
MAX_PREVIEW_FILE_MB=32
