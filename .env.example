# docker compose 读取的变量文件（编排层，不是应用配置本身）。
# 复制成 .env 后按环境修改：cp .env.example .env
# .env 已被 git 忽略，真实令牌只放这里，不进镜像、不进 Git。

# ---- 共享盘（网盘）----
# 宿主机上共享盘的实际挂载点。
# 真实生产环境示例（挂载 \\10.2.1.48\电商业务（深圳安莱亚）\数据策略 之后）：
# SHARE_HOST_PATH=/data/share
# 开发机默认用仓库里的模拟目录：
SHARE_HOST_PATH=./网盘模拟数据
# 容器内看到的路径，会作为 FILE_ROOT 传给应用。
CONTAINER_SHARE_PATH=/data/share

# ---- 监听 ----
# 127.0.0.1 = 只有本机能访问；要让内网同事访问，改成 0.0.0.0
APP_BIND_ADDR=0.0.0.0
HOST_PORT=8080

# ---- 入口保护（不是身份认证）----
# 生产必填：openssl rand -hex 32
APP_ACCESS_TOKEN=

# ---- 可选 AI 语义重排（留空即纯本地索引检索）----
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=12

# ---- 索引与扫描 ----
ALLOWED_EXTENSIONS=.xlsx,.xls,.xlsm,.xlsb,.csv,.tsv,.ods
LOG_LEVEL=INFO
TZ=Asia/Shanghai
APP_CPUS=2.0
APP_MEM_LIMIT=2g

# ---- 仅生产覆盖文件使用 ----
# IMAGE=registry.intranet/file-finder:1.4.2
# INDEX_DB_HOST_PATH=/srv/file-finder/data

# 目录权限：默认开启，强制登录；普通账号需由超级管理员显式授权
DIRECTORY_ACL_ENABLED=true

# 仅演示环境开启：在已分类业务域生成并滚动保留 7 天的真实 CSV 示例报表
DEMO_MODE=false
# 演示查询随机约 2–4 秒；真实检索更慢时不额外等待。两项设为 0 可关闭。
DEMO_SEARCH_MIN_SECONDS=2
DEMO_SEARCH_MAX_SECONDS=4
# 演示模式下 AI 回答随机约 5–10 秒；模型更慢时不追加等待。
DEMO_AI_MIN_SECONDS=5
DEMO_AI_MAX_SECONDS=10
# 演示刷新随机约 2–4 分钟；两项设为 0 可关闭，实际扫描更慢时不等待。
DEMO_SCAN_MIN_SECONDS=120
DEMO_SCAN_MAX_SECONDS=240

# ---- 模型服务测试 Key（仅本地测试脚本使用，真实值放 .env，不进 Git）----
# 魔搭 ModelScope
MODELSCOPE_KEY_LIN=
MODELSCOPE_KEY_QI=
MODELSCOPE_KEY_QI_BACKUP=
# 白山云
BAISHAN_KEY_LIN=
BAISHAN_KEY_QI=
# 硅基流动
SILICONFLOW_KEY=
# 阿里百炼
BAILIAN_KEY=
# 阿里云 dashscope
ALIYUN_KEY_LIN=

# 云端扫描与服务端限行预览
SCAN_WORKERS=4
SCAN_QUEUE_SIZE=1024
SCAN_BATCH_SIZE=300
SCAN_COMMIT_SECONDS=1
MAX_PREVIEW_FILE_MB=32
